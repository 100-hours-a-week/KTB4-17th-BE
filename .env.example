# 데이터베이스
DB_URL=jdbc:mysql://localhost:3306/dating_app?serverTimezone=UTC&useSSL=false
DB_USERNAME=your-db-username
DB_PASSWORD=your-db-password

# JPA 및 로그
JPA_DDL_AUTO=create
JPA_FORMAT_SQL=true
LOGGING_LEVEL_HIBERNATE_SQL=debug
LOGGING_LEVEL_HIBERNATE_BIND=trace

# JWT
JWT_SECRET=base64-encoded-jwt-secret
JWT_PENDING_EXPIRATION_MINUTES=10
JWT_SERVICE_EXPIRATION_MINUTES=15
JWT_REFRESH_EXPIRATION_DAYS=30

# 카카오 OAuth
CLIENT_ID=your-kakao-client-id
CLIENT_SECRET=your-kakao-client-secret
REDIRECT_URI=your-kakao-redirect-uri
AUTHORIZATION_URI=https://kauth.kakao.com/oauth/authorize
TOKEN_URI=https://kauth.kakao.com/oauth/token
USER_INFO_URI=https://kapi.kakao.com/v2/user/me
KAKAO_TALK_PROFILE_URI=https://kapi.kakao.com/v1/api/talk/profile

# 웹 및 쿠키 설정
AUTH_SERVICE_REDIRECT_URI=your-service-redirect-uri
AUTH_REGISTRATION_REDIRECT_URI=your-registration-redirect-uri
AUTH_ONBOARDING_REDIRECT_URI=your-onboarding-redirect-uri
# 로그인 화면이 서비스 첫 화면과 다를 때만 지정
# AUTH_LOGIN_REDIRECT_URI=your-login-screen-uri
AUTH_COOKIE_SECURE=false
AUTH_COOKIE_SAME_SITE=Lax
AUTH_ALLOWED_ORIGINS=http://localhost:5173

# AI 연습 연동
AI_PRACTICE_BASE_URL=http://localhost:8000
AI_PRACTICE_INITIAL_SESSION_PATH=/ai/api/v1/practice/start
AI_PRACTICE_MESSAGE_PATH=/ai/api/v1/practice/%s/messages
AI_PRACTICE_RETRY_PATH=/ai/api/v1/practice/%s/retry
AI_PRACTICE_END_SESSION_PATH=/ai/api/v1/practice/%s/end
AI_PRACTICE_API_KEY=
AI_PRACTICE_CALLBACK_SECRET=
AI_PRACTICE_CONNECT_TIMEOUT_MS=3000
AI_PRACTICE_READ_TIMEOUT_MS=120000
AI_PRACTICE_DAILY_LIMIT=30
AI_PRACTICE_OUTBOX_MAX_FAILURES=10
AI_PRACTICE_OUTBOX_PUBLISH_DELAY_MS=1000

# AI 시뮬레이션 연동
AI_SIMULATION_BASE_URL=http://localhost:8000
AI_SIMULATION_PATH=/ai/api/v1/simulation
AI_SIMULATION_CONNECT_TIMEOUT_MS=3000
AI_SIMULATION_READ_TIMEOUT_MS=130000
AI_SIMULATION_ASYNC_POOL_SIZE=1
AI_SIMULATION_ASYNC_QUEUE_CAPACITY=4
AI_SIMULATION_ASYNC_SHUTDOWN_WAIT_SECONDS=30
AI_SIMULATION_MAX_PROCESSING_AGE_SECONDS=900

# AI 채팅 위임 연동
AI_CHAT_DELEGATION_BASE_URL=http://localhost:8000
AI_CHAT_DELEGATION_API_KEY=

# AI 페르소나 연동
AI_PERSONA_BASE_URL=http://localhost:8000

# AWS S3
AWS_S3_BUCKET=
AWS_S3_REGION=ap-northeast-2
AWS_S3_UPLOAD_URL_EXPIRATION=10m
AWS_S3_DOWNLOAD_URL_EXPIRATION=5m

# 파일 업로드 정책
APP_FILE_MAX_SIZE_BYTES=
APP_FILE_ALLOWED_MIME_TYPES=
APP_FILE_UPLOAD_INTENT_TTL=
APP_FILE_UPLOAD_INTENT_RETENTION=
APP_FILE_CLEANUP_DELAY_MS=
APP_FILE_CLEANUP_BATCH_SIZE=

# RabbitMQ 및 마이그레이션 (운영 값은 배포 환경에서 주입)
RABBITMQ_HOST=localhost
RABBITMQ_PORT=5672
RABBITMQ_STOMP_PORT=61613
RABBITMQ_USERNAME=migration
RABBITMQ_PASSWORD=migration-local
RABBITMQ_VHOST=/
RABBITMQ_CHAT_EXCHANGE=ecs.chat.events
RABBITMQ_CONFIRM_TIMEOUT_MS=5000
APP_CHAT_OUTBOX_PUBLISH_DELAY_MS=1000
APP_CHAT_OUTBOX_CLAIM_LEASE_MS=30000
APP_CHAT_OUTBOX_START_GATE_FILE=
APP_WORKERS_CHAT_OUTBOX_ENABLED=true
APP_WORKERS_AI_PRACTICE_ENABLED=true
APP_WORKERS_AI_SIMULATION_RECOVERY_ENABLED=true
APP_WORKERS_FILE_CLEANUP_ENABLED=true
