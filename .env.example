# Database
DB_URL=jdbc:mysql://localhost:3306/dating_app?serverTimezone=UTC&useSSL=false
DB_USERNAME=your-db-username
DB_PASSWORD=your-db-password

# JPA and logging
JPA_DDL_AUTO=create
JPA_FORMAT_SQL=true
LOGGING_LEVEL_HIBERNATE_SQL=debug
LOGGING_LEVEL_HIBERNATE_BIND=trace

# JWT
JWT_SECRET=base64-encoded-jwt-secret
JWT_PENDING_EXPIRATION_MINUTES=10
JWT_SERVICE_EXPIRATION_MINUTES=60

# Kakao OAuth
CLIENT_ID=your-kakao-client-id
CLIENT_SECRET=your-kakao-client-secret
REDIRECT_URI=your-kakao-redirect-uri
AUTHORIZATION_URI=https://kauth.kakao.com/oauth/authorize
TOKEN_URI=https://kauth.kakao.com/oauth/token
USER_INFO_URI=https://kapi.kakao.com/v2/user/me

# Web and cookie settings
AUTH_SERVICE_REDIRECT_URI=your-service-redirect-uri
AUTH_REGISTRATION_REDIRECT_URI=your-registration-redirect-uri
AUTH_ONBOARDING_REDIRECT_URI=your-onboarding-redirect-uri
AUTH_COOKIE_SECURE=false
AUTH_COOKIE_SAME_SITE=Lax
AUTH_ALLOWED_ORIGINS=http://localhost:5173

# AWS S3
AWS_S3_BUCKET=
AWS_S3_REGION=ap-northeast-2
AWS_S3_PRESIGNED_URL_EXPIRATION=10m